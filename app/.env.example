# NexoFin AI - Variables de Entorno de Configuración

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
# Para entorno local o Docker: postgres://usuario:password@localhost:5432/nexofin
# Si se deja vacío o en modo memoria, el sistema utilizará el motor PostgreSQL en memoria compatible (pg-mem)
DATABASE_URL=postgresql://postgres:SOYLAMEJOR@localhost:5432/nexofin_db
DB_SSL=false

# Autenticación y Seguridad
JWT_SECRET=nexofin_super_secret_jwt_key_2026_itla_progra3
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Moneda y Configuración Regional
DEFAULT_CURRENCY=DOP
TIMEZONE=America/Santo_Domingo

# CORS
CORS_ORIGIN=*

# Exige correo verificado para registrar datos financieros (RF-AUT-02). Por defecto desactivado.
REQUIRE_EMAIL_VERIFICATION=false

# Límite de intentos de inicio de sesión por ventana (RNF-SEG-06)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=30

# Asistente con Claude (https://console.anthropic.com). Sin clave se usa el motor de reglas local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
