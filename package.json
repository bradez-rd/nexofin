{
  "name": "nexofin",
  "version": "1.0.0",
  "description": "NexoFin AI - Plataforma integral de gestión financiera personal determinística con asesor IA",
  "scripts": {
    "install:all": "npm install --prefix app",
    "dev": "npm run dev --prefix app",
    "build": "npm run build --prefix app",
    "start": "npm start --prefix app",
    "test": "npm test --prefix app",
    "db:init": "npm run db:init --prefix app",
    "mobile:run": "cd android && flutter run",
    "mobile:test": "cd android && flutter test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "nexofin",
    "fintech",
    "personal-finance",
    "clean-architecture",
    "postgresql",
    "express"
  ],
  "author": "Paola Piantini, Brailin Mendez, Romel Augusto Rojas, Luiggi Medrano",
  "license": "MIT"
}
